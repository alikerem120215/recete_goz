# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Model seçimi (Varsayılan: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Ekran tarama aralığı (saniye)
CAPTURE_INTERVAL=5.0

# Görüntü değişim algılama hassasiyeti (dhash fark eşiği: 1-64, varsayılan: 6)
HASH_THRESHOLD=6

# Kırmızı flaş uyarı süresi (milisaniye)
FLASH_DURATION_MS=1000

# Kırmızı flaş pencere şeffaflığı (0.1 - 1.0)
FLASH_ALPHA=0.38
